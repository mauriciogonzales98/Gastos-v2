<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Mismo UserSecretsId que la API a proposito: la herramienta lee la misma cadena de
      conexion que ya esta configurada, sin copiarla a ningun archivo ni pedirla de nuevo.
    -->
    <UserSecretsId>72b6e765-97ce-4f7f-9e8e-31232020a0b7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <!--
      EF va explicito y en la misma version que la API. Sin esto, Pomelo 9.0.0 arrastra
      EntityFrameworkCore.Relational 9.0.0 por transitiva y el build avisa del conflicto
      con la 9.0.18 que trae la API (MSB3277).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.18" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reusa entidades, DbContext y el hasheo de contrasenas de la API. -->
    <ProjectReference Include="..\GestionGastos.Api\GestionGastos.Api.csproj" />
  </ItemGroup>

</Project>
